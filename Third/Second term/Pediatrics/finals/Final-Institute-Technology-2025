<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فاينل معهد تكنولوجي 2025 - طب الأطفال (VIP)</title>
    <style>
        :root { --primary-color: #dc3545; --primary-hover: #c82333; --success-color: #28a745; --danger-color: #dc3545; --background-color: #f8d7da; --card-bg: rgba(255, 255, 255, 0.98); }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: var(--background-color); color: #333; line-height: 1.6; margin: 0; padding: 20px; position: relative; min-height: 100vh; }
        body::before { content: ""; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; height: 100%; background-image: url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhIt1bXXa9kD1APc8qcfG9r-s-lmI_3C6Kg13rCIvfgPkMlXpBOud245tlNkAdnGQHEH6dNeYIn8OhziKzqcteGbRyAiZry4C0raemhyIsC-_BjpcPxZM4cHb13JGjRPNXagxJR27aj7SAnQDc14ciVx5JEHlLuu3Nju7i-geTkdZK4ySIHlL9p6ULremM/s16000/%D8%AA%D9%85%D8%B1%D9%8A%D8%B6%D9%88%D9%84%D9%88%D8%AC%D9%8A%20%D9%84%D9%88%D8%AC%D9%88%20png.png'); background-repeat: no-repeat; background-position: center; background-size: 45%; opacity: 0.07; z-index: -1; pointer-events: none; }
        .container { max-width: 950px; margin: auto; background: var(--card-bg); padding: 25px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); border-top: 5px solid var(--primary-color); }
        h1 { text-align: center; color: var(--primary-color); margin-bottom: 5px; font-size: 1.8em; }
        .sub-title { text-align: center; color: #666; margin-bottom: 25px; font-weight: bold; }
        .setup-card { text-align: center; padding: 30px 15px; background: #fff; border-radius: 8px; border: 1px dashed #ccc; max-width: 500px; margin: auto; }
        .form-group { margin-bottom: 20px; text-align: right; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 8px; color: #444; }
        .form-control { width: 100%; padding: 10px; font-size: 1em; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
        .quiz-layout { display: table; width: 100%; margin-top: 20px; display: none; }
        .quiz-main { display: table-cell; width: 73%; vertical-align: top; padding-left: 20px; }
        .quiz-sidebar { display: table-cell; width: 27%; vertical-align: top; border-right: 2px solid #e2e8f0; padding-right: 20px; }
        .sidebar-title { font-weight: bold; margin-bottom: 12px; text-align: center; color: #4a5568; font-size: 0.95em; }
        .question-grid { display: block; text-align: center; }
        .nav-circle { display: inline-block; width: 40px; height: 40px; line-height: 40px; margin: 5px; background: #edf2f7; color: #4a5568; border-radius: 50%; text-align: center; font-weight: bold; cursor: pointer; transition: all 0.2s; user-select: none; }
        .nav-circle:hover { background: #cbd5e0; }
        .nav-circle.active { box-shadow: 0 0 0 3px var(--primary-color); }
        .nav-circle.answered { background: #f5c6cb; color: #721c24; }
        .nav-circle.correct { background: #c6f6d5 !important; color: #22543d !important; }
        .nav-circle.incorrect { background: #fed7d7 !important; color: #742a2a !important; }
        .question-box { background: #f7fafc; border: 1px solid #e2e8f0; border-left: 5px solid var(--primary-color); padding: 20px; border-radius: 8px; direction: ltr; text-align: left; margin-bottom: 25px; min-height: 200px; }
        .question-text { font-size: 1.15em; font-weight: bold; color: #1a202c; margin-bottom: 15px; }
        .options-list label { display: block; background: #fff; padding: 12px 15px; margin-bottom: 10px; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; transition: background 0.2s; }
        .options-list label:hover { background: #edf2f7; }
        .options-list input { margin-right: 12px; transform: scale(1.1); }
        #timerBox { text-align: center; font-size: 1.4em; font-weight: bold; color: var(--danger-color); margin-bottom: 15px; display: none; }
        .action-buttons { text-align: center; margin-top: 15px; }
        .btn { display: inline-block; padding: 10px 24px; font-size: 1em; font-weight: bold; border-radius: 6px; cursor: pointer; border: none; transition: background 0.2s; margin: 5px; text-decoration: none; }
        .btn-primary { background: var(--primary-color); color: #fff; }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-secondary { background: #718096; color: #fff; }
        .btn-secondary:hover { background: #4a5568; }
        .btn-success { background: var(--success-color); color: #fff; width: 100%; margin-top: 15px; }
        .btn-success:hover { background: #218838; }
        #resultPanel { margin-top: 25px; padding: 20px; border-radius: 8px; text-align: center; font-size: 1.3em; font-weight: bold; display: none; }
        .footer { text-align: center; margin-top: 40px; padding-top: 15px; border-top: 1px dashed #cbd5e0; font-size: 0.95em; }
        .footer a { color: var(--primary-color); text-decoration: none; font-weight: bold; margin: 0 8px; }
        .option-correct { background-color: #c6f6d5 !important; border-color: #38a169 !important; color: #22543d; font-weight: bold; }
        .option-incorrect { background-color: #fed7d7 !important; border-color: #e53e3e !important; color: #742a2a; }
        @media (max-width: 768px) { .quiz-layout, .quiz-main, .quiz-sidebar { display: block; width: 100%; padding: 0; border: none; } .quiz-sidebar { margin-top: 25px; border-top: 2px solid #e2e8f0; padding-top: 15px; } }
    </style>
</head>
<body>
<div class="container">
    <h1>🔥 فاينل معهد تكنولوجي 2025 (VIP)</h1>
    <div class="sub-title" id="quizMeta">جروب تمريضولوجي المعتمد للتميز التعليمي</div>
    <div id="timerBox">الوقت المتبقي: <span id="timeClock">00:00</span></div>

    <div class="setup-card" id="setupCard">
        <h3>⚙️ إعدادات الفاينل</h3>
        <div class="form-group">
            <label>⏱️ حدد وقت الحل يدوياً (بالدقائق):</label>
            <input type="number" id="quizDurationInput" class="form-control" placeholder="مثال: 60 (اتركه فارغاً لحل مفتوح بدون وقت)">
        </div>
        <div class="form-group">
            <label>🔀 نظام ترتيب الأسئلة:</label>
            <select id="orderType" class="form-control">
                <option value="normal">الترتيب الطبيعي (نفس الملزمة)</option>
                <option value="random">ترتيب عشوائي (زيادة التحدي 🔥)</option>
            </select>
        </div>
        <button class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 1.1em;" onclick="initiateQuizEngine()">ابدأ تحدي الفاينل الآن 🚀</button>
    </div>

    <div class="quiz-layout" id="quizLayout">
        <div class="quiz-main">
            <div class="question-box" id="questionBox"></div>
            <div class="action-buttons">
                <button class="btn btn-secondary" id="prevBtn" onclick="navigateQuestion(-1)">⬅️ السابق</button>
                <button class="btn btn-primary" id="nextBtn" onclick="navigateQuestion(1)">التالي ➡️</button>
            </div>
        </div>
        <div class="quiz-sidebar">
            <div class="sidebar-title">📌 خريطة تتبع الأسئلة</div>
            <div class="question-grid" id="navigationGrid"></div>
            <button class="btn btn-success" id="submitQuizBtn" onclick="finalizeQuizSubmission()">إنهاء الفاينل وتسليم الورقة 📝</button>
        </div>
    </div>
    <div id="resultPanel"></div>
    <div class="footer"><p>👨‍⚕️ <strong>إعداد وتنسيق: جروب تمريضولوجي</strong></p><p><a href="https://t.me/Nursingology2025" target="_blank">🔗 قناة التليجرام الرسمية</a> | <a href="https://t.me/NursBeniSuefBot" target="_blank">🤖 بوت القناة المساعد</a></p></div>
</div>

<script>
    const originalQuestionsDataset = [
        { id: 1, text: "Late manifestation of rickets include?", options: { A: "A. Increased head size", B: "B. Chest rosary beads", C: "C. Irritability", D: "D. A and B" }, correct: "D" },
        { id: 2, text: "Major criteria of rheumatic fever?", options: { A: "A. Carditis", B: "B. Arthritis", C: "C. Chorea", D: "D. All of the above" }, correct: "A" },
        { id: 3, text: "Anemia complications include all of the above EXCEPT?", options: { A: "A. Heart failure", B: "B. Growth retardation", C: "C. Obesity", D: "D. Syncopal attacks" }, correct: "C" },
        { id: 4, text: "Iron deficiency anemia treatment includes all EXCEPT?", options: { A: "A. Iron therapy", B: "B. Packed red cell transfusion in mild cases", C: "C. Treatment of cause (parasites/ankylostoma)", D: "D. Diet rich in iron" }, correct: "B" },
        { id: 5, text: "Rheumatic fever caused by?", options: { A: "A. Fungi", B: "B. Staphylococci", C: "C. Streptococci", D: "D. Virus" }, correct: "C" },
        { id: 6, text: "Causes of nephritic syndrome include?", options: { A: "A. Pancreatitis", B: "B. Liver disease", C: "C. Hypotension", D: "D. Hereditary causes" }, correct: "D" },
        { id: 7, text: "Regarding chronic kidney failure, which is FALSE?", options: { A: "A. It is rapid (hours-weeks) reduction of renal functions", B: "B. Gradual progressive and usually irreversible reduction", C: "C. Growth failure and vomiting may be complications", D: "D. Pallor, edema, bleeding tendency, acidosis are manifestations" }, correct: "A" },
        { id: 8, text: "Increased destruction of RBCs causes include all EXCEPT?", options: { A: "A. Thalassemia", B: "B. Sickle cell anemia", C: "C. G6PD deficiency", D: "D. Folic deficiency" }, correct: "D" },
        { id: 9, text: "Cause of acute renal failure includes the following EXCEPT one?", options: { A: "A. Shock", B: "B. Fever", C: "C. Dehydration", D: "D. Nephritis" }, correct: "B" },
        { id: 10, text: "Reduction of hemoglobin concentration below the normal level is called?", options: { A: "A. Carditis", B: "B. Dehydration", C: "C. Anemia", D: "D. Diabetes mellitus" }, correct: "C" },
        { id: 11, text: "Regarding nephrotic syndrome manifestations, which is FALSE?", options: { A: "A. Generalized edema", B: "B. Hypertension", C: "C. Heavy proteinuria", D: "D. Hypoalbuminemia" }, correct: "B" },
        { id: 12, text: "Causes of iron deficiency anemia include?", options: { A: "A. Decreased iron intake", B: "B. Blood loss", C: "C. Defective absorption of iron", D: "D. All of the above" }, correct: "D" },
        { id: 13, text: "General manifestation of anemia includes all EXCEPT?", options: { A: "A. Pallor", B: "B. Fatigue", C: "C. Tachycardia", D: "D. Hematuria" }, correct: "D" },
        { id: 14, text: "Specific treatment of nephrotic syndrome?", options: { A: "A. Corticosteroids", B: "B. Protein restriction", C: "C. Rest", D: "D. Fluid balance" }, correct: "A" },
        { id: 15, text: "Which complication of anemia?", options: { A: "A. Heart failure", B: "B. Cystitis", C: "C. Nephritis", D: "D. Diabetes mellitus" }, correct: "A" },
        { id: 16, text: "Which method by which diphtheria is spread?", options: { A: "A. Feces and urine", B: "B. Foods", C: "C. Sexual activity", D: "D. Droplets" }, correct: "D" },
        { id: 17, text: "Physiological jaundice causes are?", options: { A: "A. Production increased due to increased RBCs volume and decreased red cell life span", B: "B. Uptake: decreased uptake", C: "C. Conjugation: decrease activity of Glucuronyl transferase enzyme", D: "D. All of the above" }, correct: "D" },
        { id: 18, text: "Treatment of neonatal jaundice includes?", options: { A: "A. Diuretics", B: "B. Phototherapy", C: "C. Oxygen", D: "D. Antiemetic drugs" }, correct: "B" },
        { id: 19, text: "Which causes yellowish discoloration of the skin?", options: { A: "A. Jaundice", B: "B. Anemia", C: "C. Both A and B", D: "D. Seizures" }, correct: "A" },
        { id: 20, text: "Manifestation of perinatal asphyxia includes?", options: { A: "A. Edema", B: "B. Cyanosis", C: "C. Oliguria", D: "D. Chest pain" }, correct: "B" },
        { id: 21, text: "Penicillin used to treatment rheumatic fever?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 22, text: "Acute renal failure is gradually progressive and irreversible reduction of renal functions?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 23, text: "Perinatal asphyxia may cause seizures, usually in the first 24 hours?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 24, text: "Anemia is reduction of hemoglobin concentration and/or hematocrit below the normal range?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 25, text: "Nephritic syndrome is the inflammation of renal glomeruli?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 26, text: "Physiologic anemia is usually noticed at 8-12 weeks of age?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 27, text: "Chronic kidney failure is rapid (hours-weeks) reduction of renal functions?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 28, text: "Development means increase in weight and length?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 29, text: "Jaundice is the pathological accumulation of fluid?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 30, text: "Hypertensive encephalopathy is one complication of the renal disease?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 31, text: "Phototherapy is the treatment of neonatal jaundice?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 32, text: "Dialysis used with severe renal insufficiency?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 33, text: "The cause of physiological jaundice is a hemolytic anemia?", options: { A: "A. True", B: "B. False" }, correct: "B" },
        { id: 34, text: "Defective absorption of iron is the one cause of iron deficiency anemia?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 35, text: "Neonatal pneumonia risk factors are prolonged rupture of membranes and prematurity?", options: { A: "A. True", B: "B. False" }, correct: "A" },
        { id: 36, text: "Heart failure and growth retardation are the complication of anemia?", options: { A: "A. True", B: "B. False" }, correct: "A" }
    ];

    let dynamicQuizQuestions = []; let activeQuestionCursor = 0; let userSelectedAnswers = {}; let countdownInterval; let isQuizSubmitted = false;
    function shuffleArray(array) { for (let i = array.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [array[i], array[j]] = [array[j], array[i]]; } return array; }
    function initiateQuizEngine() { const orderType = document.getElementById('orderType').value; dynamicQuizQuestions = [...originalQuestionsDataset]; if (orderType === 'random') shuffleArray(dynamicQuizQuestions); const durationInput = document.getElementById('quizDurationInput').value; if (durationInput && parseInt(durationInput) > 0) { document.getElementById('timerBox').style.display = 'block'; activateCountdownTimer(parseInt(durationInput)); } document.getElementById('setupCard').style.display = 'none'; document.getElementById('quizLayout').style.display = 'table'; document.getElementById('quizMeta').textContent = `عدد الأسئلة الكلي: ${dynamicQuizQuestions.length} أسئلة`; generateSidebarNavigationGrid(); renderActiveQuestion(); }
    function generateSidebarNavigationGrid() { const gridContainer = document.getElementById('navigationGrid'); gridContainer.innerHTML = ''; dynamicQuizQuestions.forEach((q, index) => { const circle = document.createElement('div'); circle.className = 'nav-circle'; circle.id = `nav-idx-${index}`; circle.textContent = index + 1; circle.onclick = () => { jumpToSpecificQuestion(index); }; gridContainer.appendChild(circle); }); updateSidebarStatusVisuals(); }
    function renderActiveQuestion() { const currentQuestion = dynamicQuizQuestions[activeQuestionCursor]; const container = document.getElementById('questionBox'); let optionsHTML = ''; for (let [key, val] of Object.entries(currentQuestion.options)) { let labelClass = ''; let checkedStr = (userSelectedAnswers[currentQuestion.id] === key) ? 'checked' : ''; let disabledStr = isQuizSubmitted ? 'disabled' : ''; if (isQuizSubmitted) { if (key === currentQuestion.correct) labelClass = 'option-correct'; else if (userSelectedAnswers[currentQuestion.id] === key && key !== currentQuestion.correct) labelClass = 'option-incorrect'; } optionsHTML += `<label class="${labelClass}"><input type="radio" name="active_opt" value="${key}" ${checkedStr} ${disabledStr} onchange="registerUserSelection('${currentQuestion.id}', '${key}')"> ${val}</label>`; } container.innerHTML = `<div class="question-text">${activeQuestionCursor + 1}. ${currentQuestion.text}</div><div class="options-list">${optionsHTML}</div>`; document.getElementById('prevBtn').disabled = (activeQuestionCursor === 0); document.getElementById('nextBtn').textContent = (activeQuestionCursor === dynamicQuizQuestions.length - 1) ? 'المراجعة والإنهاء 🏁' : 'التالي ➡️'; updateSidebarStatusVisuals(); }
    function registerUserSelection(questionId, selectedValue) { if (isQuizSubmitted) return; userSelectedAnswers[questionId] = selectedValue; updateSidebarStatusVisuals(); }
    function updateSidebarStatusVisuals() { dynamicQuizQuestions.forEach((q, index) => { const circle = document.getElementById(`nav-idx-${index}`); if (!circle) return; circle.classList.remove('active', 'answered'); if (index === activeQuestionCursor) circle.classList.add('active'); if (userSelectedAnswers[q.id]) circle.classList.add('answered'); if (isQuizSubmitted) { circle.classList.remove('active', 'answered'); if (userSelectedAnswers[q.id] === q.correct) circle.classList.add('correct'); else circle.classList.add('incorrect'); } }); }
    function navigateQuestion(step) { let newCursor = activeQuestionCursor + step; if (newCursor >= 0 && newCursor < dynamicQuizQuestions.length) { activeQuestionCursor = newCursor; renderActiveQuestion(); } }
    function jumpToSpecificQuestion(index) { activeQuestionCursor = index; renderActiveQuestion(); }
    function activateCountdownTimer(minutes) { let totalSeconds = minutes * 60; const clockDisplay = document.getElementById('timeClock'); countdownInterval = setInterval(() => { let m = Math.floor(totalSeconds / 60); let s = totalSeconds % 60; m = m < 10 ? "0" + m : m; s = s < 10 ? "0" + s : s; clockDisplay.textContent = `${m}:${s}`; if (--totalSeconds < 0) { clearInterval(countdownInterval); alert("⏰ انتهى الوقت المخصص للاختبار! سيتم تسليم إجاباتك الحالية فوراً تلقائياً."); finalizeQuizSubmission(); } }, 1000); }
    function finalizeQuizSubmission() { if (isQuizSubmitted) return; if (countdownInterval) clearInterval(countdownInterval); isQuizSubmitted = true; let totalCorrectScore = 0; dynamicQuizQuestions.forEach(q => { if (userSelectedAnswers[q.id] === q.correct) totalCorrectScore++; }); const totalQuestionsCount = dynamicQuizQuestions.length; const finalResultPanel = document.getElementById('resultPanel'); finalResultPanel.style.display = "block"; if (totalCorrectScore === totalQuestionsCount) { finalResultPanel.style.backgroundColor = "#c6f6d5"; finalResultPanel.style.color = "#22543d"; finalResultPanel.innerHTML = `🏆 وحش الفاينل! نتيجتك: ${totalCorrectScore} من ${totalQuestionsCount}!`; } else if (totalCorrectScore >= totalQuestionsCount / 2) { finalResultPanel.style.backgroundColor = "#feebc8"; finalResultPanel.style.color = "#744210"; finalResultPanel.innerHTML = `💪 نتيجة ممتازة يا بطل! نتيجتك: ${totalCorrectScore} من ${totalQuestionsCount}.`; } else { finalResultPanel.style.backgroundColor = "#f8d7da"; finalResultPanel.style.color = "#721c24"; finalResultPanel.innerHTML = `📚 الفاينل محتاج شدة حيل. نتيجتك: ${totalCorrectScore} من ${totalQuestionsCount}.`; } document.getElementById('submitQuizBtn').style.display = 'none'; renderActiveQuestion(); }
</script>
</body>
</html>
